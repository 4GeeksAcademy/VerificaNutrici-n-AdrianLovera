      "id": "2fa8012c-6bd9-4ea0-90a8-8aea60eb1dab",
      "name": "Si - Hay datos nutricionales suficientes",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        3344,
        3776
      ],
      "notesInFlow": true,
      "notes": "Usa tres comprobaciones numéricas integradas de n8n unidas con AND: azúcar, sal y grasa deben existir. El valor 0 existe y es válido; los campos ausentes envían el producto a la respuesta de datos insuficientes."
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { error: 'datos_nutricionales_insuficientes', mensaje: 'El producto aparece en la base de datos, pero no tiene valores utilizables de azúcar, sal y grasa por cada 100 g. No podemos evaluarlo de forma fiable.', barcode: $('Campos - Normalizar solicitud').item.json.barcode, producto: $json.productName, camposRequeridos: ['sugars_100g', 'salt_100g', 'fat_100g'] } }}",
        "options": {
          "responseCode": 200,
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "application/json; charset=utf-8"
              }
            ]
          }
        }
      },
      "id": "d4269d21-ebac-482f-ae46-f6d30348e32d",
      "name": "Responder - Datos nutricionales insuficientes",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        3824,
        3984
      ],
      "notesInFlow": true,
      "notes": "La falta de datos es una respuesta informativa, no un error del servidor: HTTP 200, application/json."
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1d21f90-2a80-42be-a2ef-1f2e4f5d0029",
              "name": "sugarFlag",
              "value": "={{ $json.sugars100g < 5 ? 'low' : ($json.sugars100g <= 22.5 ? 'medium' : 'high') }}",
              "type": "string"
            },
            {
              "id": "a1d21f90-2a80-42be-a2ef-1f2e4f5d0030",
              "name": "sugarHigh",
              "value": "={{ $json.sugars100g > 22.5 }}",
              "type": "boolean"
            },
            {
              "id": "a1d21f90-2a80-42be-a2ef-1f2e4f5d0031",
              "name": "saltFlag",
              "value": "={{ $json.salt100g > 1.5 ? 'high' : 'not high' }}",
              "type": "string"
            },
            {
              "id": "a1d21f90-2a80-42be-a2ef-1f2e4f5d0032",
              "name": "saltHigh",
              "value": "={{ $json.salt100g > 1.5 }}",
              "type": "boolean"
            },
            {
              "id": "a1d21f90-2a80-42be-a2ef-1f2e4f5d0033",
              "name": "fatFlag",
              "value": "={{ $json.fat100g > 17.5 ? 'high' : 'not high' }}",
              "type": "string"
            },
            {
              "id": "a1d21f90-2a80-42be-a2ef-1f2e4f5d0034",
              "name": "fatHigh",
              "value": "={{ $json.fat100g > 17.5 }}",
              "type": "boolean"
            },
            {
              "id": "a1d21f90-2a80-42be-a2ef-1f2e4f5d0035",
              "name": "highNutrientCount",
              "value": "={{ ($json.sugars100g > 22.5 ? 1 : 0) + ($json.salt100g > 1.5 ? 1 : 0) + ($json.fat100g > 17.5 ? 1 : 0) }}",
              "type": "number"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "22ff01aa-f399-4760-b9fe-3477034f657d",
      "name": "Campos - Clasificar semáforo nutricional",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        3824,
        3744
      ],
      "notesInFlow": true,
      "notes": "Umbrales por cada 100 g: azúcar bajo <5, medio entre 5 y 22,5 inclusive, alto >22,5; sal alta >1,5; grasa alta >17,5. El azúcar medio no cuenta como nutriente alto."
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1d21f90-2a80-42be-a2ef-1f2e4f5d0037",
              "name": "trafficLightVerdict",
              "value": "={{ $json.highNutrientCount === 0 ? 'healthy' : ($json.highNutrientCount === 1 ? 'moderate' : 'unhealthy') }}",
              "type": "string"
            },
            {
              "id": "a1d21f90-2a80-42be-a2ef-1f2e4f5d0039",
              "name": "verdictLevel",
              "value": "={{ (() => { const trafficRank = $json.highNutrientCount === 0 ? 0 : ($json.highNutrientCount === 1 ? 1 : 2); return ['healthy','moderate','unhealthy'][Math.max(trafficRank, ({a:0,b:0,c:1,d:2,e:2})[$json.nutriscoreGrade] ?? trafficRank)]; })() }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "5def03e8-8aff-4897-a31b-ba3345fc2ea8",
      "name": "Campos - Determinar veredicto final",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        4064,
        3744
      ],
      "notesInFlow": true,
      "notes": "Calcula por separado el resultado del semáforo y el de Nutri-Score, y elige el peor. Si Nutri-Score falta o no se reconoce, usa solo el semáforo."
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const concernScore = Number($json.sugarHigh) + Number($json.saltHigh) + Number($json.fatHigh);\nreturn { json: { ...$json, concernScore } };"
      },
      "id": "94ae7594-5a80-44c2-9bc3-0669b9ba0ded",
      "name": "Código - Calcular indicador de preocupación",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4288,
        3744
      ],
      "notesInFlow": true,
      "notes": "Cálculo de un solo elemento: suma las tres banderas de nutrientes altos para obtener concernScore (0–3). No establece ni modifica el nivel del veredicto."
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ 'Redacta para quien compra un párrafo breve y amable (máximo 3 frases). Usa solo estos datos, sin inventar ni contradecir el nivel. Producto: ' + $json.productName + '. Nivel: ' + ({healthy:'saludable',moderate:'moderado',unhealthy:'no saludable'}[$json.verdictLevel]) + '. Azúcar: ' + $json.sugars100g + ' g/100 g (' + ({low:'bajo',medium:'medio',high:'alto'}[$json.sugarFlag]) + '). Sal: ' + $json.salt100g + ' g/100 g (' + ($json.saltFlag === 'high' ? 'alta' : 'no alta') + '). Grasa: ' + $json.fat100g + ' g/100 g (' + ($json.fatFlag === 'high' ? 'alta' : 'no alta') + '). Nutri-Score: ' + ($json.nutriscoreGrade ?? 'sin dato') + '. Indicador: ' + $json.concernScore + ' de 3. ' + ($json.verdictLevel === 'unhealthy' ? 'Tono comprensivo y cauteloso; sugiérelo como capricho ocasional.' : 'Tono alentador; para moderado, menciona el equilibrio.') + ' Devuelve solo el párrafo.' }}"
      },
      "id": "277d8a61-8853-4119-aeaa-3a5ce861585a",
      "name": "IA - Redactar explicación del veredicto",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.6,
      "position": [
        4560,
        3744
      ],
      "notesInFlow": true,
      "notes": "La instrucción dinámica incluye el nivel calculado y elige un tono alentador o ligeramente cauteloso. La IA explica el resultado determinista; no decide la clasificación."
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1d21f90-2a80-42be-a2ef-1f2e4f5d0045",
              "name": "verdictText",
              "value": "={{ (() => { const d = $('Código - Calcular indicador de preocupación').item.json; return `SNACKCHECK | ${d.verdictLevel === 'healthy' ? '🟢 Buena opción diaria' : d.verdictLevel === 'moderate' ? '🟡 Disfrútalo con equilibrio' : '🔴 Mejor como capricho ocasional'}\\n${d.productName}\\n\\nNUTRICIÓN POR CADA 100 g\\n${d.sugarFlag === 'high' ? '🔴' : d.sugarFlag === 'medium' ? '🟡' : '🟢'} Azúcar  ${d.sugars100g.toFixed(1)} g (${({low:'bajo',medium:'medio',high:'alto'})[d.sugarFlag]})\\n${d.saltFlag === 'high' ? '🔴' : '🟢'} Sal     ${d.salt100g.toFixed(2)} g\\n${d.fatFlag === 'high' ? '🔴' : '🟢'} Grasa   ${d.fat100g.toFixed(1)} g\\nNutri-Score: ${d.nutriscoreGrade == null ? 'sin dato' : d.nutriscoreGrade.toUpperCase()} | Indicador: ${d.concernScore}/3${d.energyKcal100g == null ? '' : `\\nEnergía: ${d.energyKcal100g} kcal`}\\n\\n${$json.text}`; })() }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "06d531a7-f3fe-4896-8ce0-26ddd08dc40a",
      "name": "Campos - Formatear veredicto para el cliente",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        5024,
        3744
      ],
      "notesInFlow": true,
      "notes": "Usa una plantilla de texto para mostrar nombre, azúcar, sal, grasa, Nutri-Score, indicador y párrafo de IA. La energía aparece solo si la API la entrega. Los datos se leen directamente del nodo de Código mediante la vinculación de elementos; no hay nodo de combinación."
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ $json.verdictText }}",
        "options": {
          "responseCode": 200,
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "text/plain; charset=utf-8"
              }
            ]
          }
        }
      },
      "id": "65c793ff-2f6f-4f91-b549-58a9c68cab5f",
      "name": "Responder - Veredicto nutricional",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        5264,
        3744
      ],
      "notesInFlow": true,
      "notes": "El veredicto se devuelve como texto sin formato: HTTP 200 y text/plain; charset=utf-8."
    },
