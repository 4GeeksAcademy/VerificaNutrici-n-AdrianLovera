              "id": "a1d21f90-2a80-42be-a2ef-1f2e4f5d0018",
              "name": "energyKcal100g",
              "value": "={{ $json.product?.nutriments?.['energy-kcal_100g'] }}",
              "type": "number"
            }
          ]
        },
        "options": {}
      },
      "id": "d962d8a5-3c58-48c7-92f9-770f3921d1f3",
